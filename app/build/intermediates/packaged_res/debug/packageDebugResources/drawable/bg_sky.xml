<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/sky_mid"
                android:endColor="@color/sky_bottom"
                android:startColor="@color/sky_top"
                android:type="linear" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_clouds" android:gravity="top|fill_horizontal" />
    <item android:drawable="@drawable/ic_mountains" android:gravity="bottom|fill_horizontal" />
</layer-list>
