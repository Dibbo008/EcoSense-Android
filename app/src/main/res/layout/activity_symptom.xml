<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sky_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back_circle"
        app:title="Symptom Link"
        app:titleCentered="true"
        app:titleTextAppearance="@style/EcoToolbarTitle"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/layout_slide_up"
            android:orientation="vertical">

            <!-- sky block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sky"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="How are you feeling?"
                    android:textColor="@android:color/white"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.95"
                    android:text="A 10-second log helps EcoSense find which air and weather conditions affect you."
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvUnlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbUnlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:indicatorColor="@android:color/white"
                    app:trackColor="#55FFFFFF"
                    app:trackCornerRadius="5dp"
                    app:trackThickness="9dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- LOG CARD -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/EcoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            style="@style/EcoSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📝  Log how you feel" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipSymptom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:chipSpacingVertical="4dp"
                            app:selectionRequired="false"
                            app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipS0"
                            style="@style/EcoChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🤕 Headache" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipS1"
                            style="@style/EcoChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😷 Cough" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipS2"
                            style="@style/EcoChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👁️ Irritation" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipS3"
                            style="@style/EcoChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌬️ Breathing" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipS4"
                            style="@style/EcoChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😫 Fatigue" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipS5"
                            style="@style/EcoChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😴 Poor sleep" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipS6"
                            style="@style/EcoChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🤧 Allergy" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipS7"
                            style="@style/EcoChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😊 Feeling fine" />
                        </com.google.android.material.chip.ChipGroup>

                        <LinearLayout
                            android:id="@+id/llSeverity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/EcoLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="How strong?" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipSeverity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSev1"
                                style="@style/EcoChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mild" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSev2"
                                style="@style/EcoChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Moderate" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSev3"
                                style="@style/EcoChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Severe" />
                            </com.google.android.material.chip.ChipGroup>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="Note (optional)"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapSentences"
                                android:maxLines="2" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLog"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="12dp"
                            android:text="Save entry"
                            app:cornerRadius="27dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- TODAY'S RISK -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRisk"
                    style="@style/EcoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/tint_temp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            style="@style/EcoSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️  Your triggers today" />

                        <TextView
                            android:id="@+id/tvRisks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/eco_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- INSIGHTS -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/EcoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            style="@style/EcoSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔎  Your patterns" />

                        <LinearLayout
                            android:id="@+id/llInsights"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvInsightNote"
                            style="@style/EcoLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="2dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- RECENT ENTRIES -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/EcoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            style="@style/EcoSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗒️  Recent entries" />

                        <LinearLayout
                            android:id="@+id/llEntries"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvEntriesEmpty"
                            style="@style/EcoLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Nothing logged yet." />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportSymptoms"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:text="Export report for my doctor (CSV)"
                            app:cornerRadius="26dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/EcoLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Patterns show correlation in your own data, not proof of cause. Not medical advice."
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
