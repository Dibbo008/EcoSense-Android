<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EcoSense" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/eco_navy</item>
        <item name="colorOnPrimary">@color/eco_on_navy</item>
        <item name="colorPrimaryContainer">@color/tint_hum</item>
        <item name="colorOnPrimaryContainer">@color/eco_text</item>
        <item name="colorSecondary">@color/eco_primary</item>
        <item name="colorOnSecondary">@color/eco_on_primary</item>
        <item name="colorSecondaryContainer">@color/tint_hum</item>
        <item name="colorOnSecondaryContainer">@color/eco_text</item>
        <item name="android:colorBackground">@color/eco_bg</item>
        <item name="colorSurface">@color/eco_card</item>
        <item name="colorOnSurface">@color/eco_text</item>
        <item name="colorOnBackground">@color/eco_text</item>
        <item name="colorSurfaceVariant">@color/eco_tile</item>
        <item name="colorOnSurfaceVariant">@color/eco_text_secondary</item>
        <item name="colorOutline">@color/eco_outline</item>
        <item name="android:statusBarColor">@color/sky_top</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@style/Animation.EcoActivity</item>
    </style>

    <style name="Animation.EcoActivity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- Big rounded white card, no outline -->
    <style name="EcoCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">@color/eco_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="EcoLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/eco_text_secondary</item>
    </style>

    <style name="EcoValue">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/eco_text</item>
    </style>

    <style name="EcoSection">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/eco_text</item>
    </style>

    <style name="EcoToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Dark pill when selected, white pill otherwise -->
    <style name="EcoChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">22dp</item>
        <item name="chipMinHeight">44dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
